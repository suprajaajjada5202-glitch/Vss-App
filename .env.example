# --- Supabase (Project Settings -> API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Never expose this to the browser. Needed to create/delete logins.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- App ----------------------------------------------------------------------
# Public URL of this app (used in email links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional; without a key, emails are skipped and logged) -----------
# https://resend.com — the sender domain must be verified there.
RESEND_API_KEY=
EMAIL_FROM="VSS Pulse <noreply@yourdomain.com>"

# --- Database setup (optional; only read by `npm run db:setup`) ---------------
# Lets the script create the tables for you instead of pasting SQL into the dashboard.
# Put ONE of these in .env.local only: never commit it, never paste it into chat.
# SUPABASE_DB_PASSWORD=
# IPv4-friendly alternative (Dashboard -> Connect -> "Session pooler"):
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
